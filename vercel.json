{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/$1",
      "status": 200
    }
  ],
  "env": {
    "MONGODB_URI": "mongodb+srv://sahilprajapati0105_db_user:Sahil_1010@cluster0.yl3q4py.mongodb.net/",
    "PORT": "5000",
    "NODE_ENV": "production"
  }
}
